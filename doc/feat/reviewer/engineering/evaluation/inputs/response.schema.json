{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Engineering review response",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "session_id",
    "strategy",
    "input_id",
    "complete",
    "assessments"
  ],
  "properties": {
    "session_id": {
      "type": "string",
      "minLength": 1
    },
    "strategy": {
      "enum": [
        "A",
        "B",
        "C"
      ]
    },
    "input_id": {
      "type": "string",
      "minLength": 1
    },
    "complete": {
      "type": "boolean"
    },
    "assessments": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "rule_id",
          "file_id",
          "qualified_function_name",
          "judgment",
          "explanation",
          "locations",
          "consequence",
          "severity",
          "corrections"
        ],
        "properties": {
          "rule_id": {
            "enum": [
              "R1",
              "R3",
              "R4"
            ]
          },
          "file_id": {
            "type": "string",
            "minLength": 1
          },
          "qualified_function_name": {
            "type": "string",
            "minLength": 1
          },
          "judgment": {
            "enum": [
              "PASS",
              "VIOLATION",
              "NOT_APPLICABLE",
              "UNCERTAIN"
            ]
          },
          "explanation": {
            "type": "string",
            "minLength": 1
          },
          "locations": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "start_line",
                "end_line",
                "quote"
              ],
              "properties": {
                "start_line": {
                  "type": "integer",
                  "minimum": 1
                },
                "end_line": {
                  "type": "integer",
                  "minimum": 1
                },
                "quote": {
                  "type": "string",
                  "minLength": 1
                }
              }
            }
          },
          "consequence": {
            "type": [
              "string",
              "null"
            ]
          },
          "severity": {
            "enum": [
              "critical",
              "major",
              "minor",
              null
            ]
          },
          "corrections": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        "allOf": [
          {
            "if": {
              "properties": {
                "judgment": {
                  "const": "VIOLATION"
                }
              }
            },
            "then": {
              "properties": {
                "locations": {
                  "minItems": 1
                },
                "consequence": {
                  "type": "string",
                  "minLength": 1
                },
                "severity": {
                  "enum": [
                    "critical",
                    "major",
                    "minor"
                  ]
                }
              }
            }
          }
        ]
      }
    }
  }
}
